# App
NEXT_PUBLIC_SERVER_URL=http://localhost:3010
PAYLOAD_SECRET=change-me-to-a-long-random-string-min-32-chars

# Database — SQLite by default (no Docker required)
USE_SQLITE=true
# DATABASE_URL=file:./data/videoplanner.db

# PostgreSQL (optional — set USE_SQLITE=false and uncomment)
# USE_SQLITE=false
# DATABASE_URL=postgresql://videoplanner:videoplanner_dev@127.0.0.1:5433/videoplanner

# Email (optional in dev — logs to console if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=contact@kabbalah.co.il
EMAIL_FROM_NAME=המקובלים

# Seed script default admin password
SEED_ADMIN_PASSWORD=ChangeMe123!
