{
  "name": "video-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3010",
    "build": "npm run generate:types && npm run generate:importmap && cross-env NODE_OPTIONS=--no-deprecation next build",
    "build:server": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3010",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation tsx node_modules/payload/bin.js",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation tsx node_modules/payload/bin.js migrate:create",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation tsx node_modules/payload/bin.js migrate",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation tsx node_modules/payload/bin.js generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation tsx node_modules/payload/bin.js generate:importmap",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed.ts",
    "migrate:productions": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/migrate-to-productions.ts",
    "sync:schema": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/sync-schema.ts",
    "init:db": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/init-db.ts",
    "import:kabbalists": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/import-kabbalists.ts",
    "lint": "next lint"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.17",
    "@fullcalendar/daygrid": "^6.1.17",
    "@fullcalendar/react": "^6.1.17",
    "@payloadcms/db-postgres": "3.85.1",
    "@payloadcms/db-sqlite": "3.85.1",
    "@payloadcms/email-nodemailer": "3.85.1",
    "@payloadcms/next": "3.85.1",
    "@payloadcms/richtext-lexical": "3.85.1",
    "@payloadcms/ui": "3.85.1",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "graphql": "^16.9.0",
    "lucide-react": "^1.31.0",
    "next": "15.4.11",
    "payload": "3.85.1",
    "postcss": "^8.5.26",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "4.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.28.0",
    "eslint-config-next": "15.4.11",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.9.0 <25"
  }
}
